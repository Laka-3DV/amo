# Amo — example only. `python -m amo init` generates random private values.
RELAY_HOST=127.0.0.1
RELAY_PORT=8765
PUBLIC_ORIGIN=https://amo.example.com
WEB_STATIC_DIR=web/dist
LOGIN_PASSWORD=REPLACE_WITH_RANDOM_LOGIN_PASSWORD
SESSION_SECRET=REPLACE_WITH_RANDOM_SESSION_SECRET
WRAPPER_TOKEN=REPLACE_WITH_RANDOM_DEVICE_TOKEN
RELAY_URL=wss://amo.example.com/ws
AMO_MACHINE_ID=my-mac
AMO_DSH_URL=http://127.0.0.1:3080
AMO_CODEX_ENABLED=1
# AMO_CODEX_BIN=/absolute/path/to/codex
# AMO_HOME=~/.amo
# ALLOW_PRIVATE_ORIGINS=0
# For multiple independent users, replace the shared login/token policy:
# LOGIN_USERS_JSON={"alice":{"password":"REPLACE_WITH_ALICE_PASSWORD","machines":["alice-mac"]}}
# WRAPPER_TOKENS_JSON={"alice-mac":"REPLACE_WITH_ALICE_DEVICE_TOKEN"}
